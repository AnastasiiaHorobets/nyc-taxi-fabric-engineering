      {
        "type": "Script",
        "typeProperties": {
          "scripts": [
            {
              "text": {
                "value": "\n-- GOLD ECONOMIC REFRESH\n-- Source: Silver Lakehouse\n-- Target: Gold Warehouse\n\nSET NOCOUNT ON;\n\n-- Check duplicate keys in Silver\nIF EXISTS (\n    SELECT 1\n    FROM lh_nyc_taxi.dbo.silver_worldbank_gdp\n    GROUP BY country_code, year\n    HAVING COUNT(*) > 1\n)\n    THROW 50001, 'Duplicate GDP source keys', 1;\n\nIF EXISTS (\n    SELECT 1\n    FROM lh_nyc_taxi.dbo.silver_ecb_fx_rates\n    GROUP BY date, currency\n    HAVING COUNT(*) > 1\n)\n    THROW 50002, 'Duplicate FX source keys', 1;\n\n-- Check duplicate keys in Gold\nIF EXISTS (\n    SELECT 1\n    FROM dbo.DimGDP\n    GROUP BY country_code, year\n    HAVING COUNT(*) > 1\n)\n    THROW 50003, 'Duplicate GDP target keys', 1;\n\nIF EXISTS (\n    SELECT 1\n    FROM dbo.DimFX\n    GROUP BY fx_date, currency\n    HAVING COUNT(*) > 1\n)\n    THROW 50004, 'Duplicate FX target keys', 1;\n\n-- Refresh DimGDP\nMERGE dbo.DimGDP AS target\nUSING (\n    SELECT\n        country_code,\n        year,\n        gdp_usd\n    FROM lh_nyc_taxi.dbo.silver_worldbank_gdp\n    WHERE country_code IS NOT NULL\n      AND year IS NOT NULL\n) AS source\nON target.country_code = source.country_code\nAND target.year = source.year\n\nWHEN MATCHED THEN\n    UPDATE SET\n        target.gdp_usd = source.gdp_usd\n\nWHEN NOT MATCHED BY TARGET THEN\n    INSERT (country_code, year, gdp_usd)\n    VALUES (source.country_code, source.year, source.gdp_usd);\n\n-- Refresh DimFX\nMERGE dbo.DimFX AS target\nUSING (\n    SELECT\n        date AS fx_date,\n        currency,\n        usd_per_eur\n    FROM lh_nyc_taxi.dbo.silver_ecb_fx_rates\n    WHERE date IS NOT NULL\n      AND currency IS NOT NULL\n) AS source\nON target.fx_date = source.fx_date\nAND target.currency = source.currency\n\nWHEN MATCHED THEN\n    UPDATE SET\n        target.usd_per_eur = source.usd_per_eur\n\nWHEN NOT MATCHED BY TARGET THEN\n    INSERT (fx_date, currency, usd_per_eur)\n    VALUES (source.fx_date, source.currency, source.usd_per_eur);",
                "type": "Expression"
              },
              "type": "NonQuery"
            }
          ],
          "scriptBlockExecutionTimeout": "02:00:00"
        },
