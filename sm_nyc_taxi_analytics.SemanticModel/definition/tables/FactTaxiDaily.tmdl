table FactTaxiDaily
	lineageTag: a3e9e946-6a5e-43b0-a310-1ce57d335df6
	sourceLineageTag: [dbo].[FactTaxiDaily]

	measure 'Average Fare USD' =
			
			DIVIDE(
			    SUMX(
			        FactTaxiDaily,
			        FactTaxiDaily[avg_fare_usd] * FactTaxiDaily[total_trips]
			    ),
			    SUM(FactTaxiDaily[total_trips])
			)
		lineageTag: 39ad7697-ab73-4fb1-96ee-c5b1894e13e6

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Revenue EUR' = ```
			
			SUMX(
			    VALUES(DimDate[full_date]),
			    VAR CurrentDate = DimDate[full_date]
			    VAR Rate =
			        MAXX(
			            TOPN(
			                1,
			                FILTER(
			                    ALL(DimFX),
			                    DimFX[currency] = "USD"
			                        && DimFX[fx_date] <= CurrentDate
			                ),
			                DimFX[fx_date], DESC
			            ),
			            DimFX[usd_per_eur]
			        )
			    VAR RevenueUSD =
			        CALCULATE(SUM(FactTaxiDaily[total_revenue_usd]))
			    RETURN
			        DIVIDE(RevenueUSD, Rate)
			)
			
			```
		lineageTag: fef7dbd3-c6d3-458b-8963-4360ac97b8b7

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

